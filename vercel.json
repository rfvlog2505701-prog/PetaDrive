{
  "rewrites": [
    { "source": "/d/:id", "destination": "/d.html?id=:id" },
    { "source": "/auth", "destination": "/auth/login.html" },
    { "source": "/app", "destination": "/app/dashboard.html" }
  ],
  "functions": {
    "api/upload.js":        { "maxDuration": 30 },
    "api/upload-public.js": { "maxDuration": 30 },
    "api/token.js":         { "maxDuration": 10 },
    "api/publish.js":       { "maxDuration": 10 },
    "api/unpublish.js":     { "maxDuration": 10 }
  }
}
