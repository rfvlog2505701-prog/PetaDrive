# Copy each of these into Vercel → Project → Settings → Environment Variables.
# Do NOT put any of these in a .env file that gets committed to GitHub.
# This file is just a reference list — it is safe to commit because it has no real values.

# Firebase Admin service account JSON, as a single-line string.
# Firebase Console → Project settings → Service accounts → Generate new private key,
# then paste the ENTIRE downloaded JSON file content here as one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", "...": "..."}

# Your Firebase Realtime Database URL (same one already used in the client config).
FIREBASE_DATABASE_URL=https://petadrive-97ae1-default-rtdb.firebaseio.com

# DropLink's secret API key. This used to be hardcoded in the browser JS — now it
# only lives here, and only api/upload.js ever reads it.
DROP_API_KEY=dl_xxx

# Google reCAPTCHA v3 secret key (from https://www.google.com/recaptcha/admin).
# If you leave this unset, token issuance still works but skips bot verification.
RECAPTCHA_SECRET_KEY=

# Optional — your deployed site's base URL, used when building share links
# (https://your-project.vercel.app). If unset, it's inferred from the request.
SITE_URL=
